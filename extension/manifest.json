{
  "manifest_version": 3,
  "name": "课堂档案 · 纪要存档",
  "version": "1.5.1",
  "description": "主动读取已复制的腾讯会议纪要，可附课堂笔记图片，预览后导入选定课节的课堂总结。",
  "permissions": ["storage", "clipboardRead", "activeTab", "scripting", "tabs"],
  "host_permissions": ["https://mooodle.lovable.app/*", "https://elwiaeitctyhmockanld.supabase.co/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://mooodle.lovable.app/*", "https://id-preview--3dd5f5e0-1336-4d26-858d-3ccea85aeb60.lovable.app/*"],
    "js": ["bridge.js"]
  }]
}
